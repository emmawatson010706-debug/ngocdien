# Supabase public URL/key: được phép dùng ở client để đọc dữ liệu công khai theo RLS
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Chỉ dùng ở server/API route. Không bao giờ đưa vào frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenWeatherMap server-only
OWM_API_KEY=your_openweathermap_key_here
OWM_CITY=1568574

# Site
NEXT_PUBLIC_SITE_URL=https://www.ngocdien.info.vn
